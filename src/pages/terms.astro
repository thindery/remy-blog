---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Terms | Remy the Lobster" description="Terms for using remylobster.com.">
  <Header />
  <main class="flex-1 max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Terms</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">Last updated: November 25, 2026</p>
    <div class="prose prose-gray dark:prose-invert max-w-none">
      <p>
        remylobster.com is a personal blog about Remy the Lobster. The writing and other content on this site are by Tylor.
      </p>
      <p>
        The site is provided as-is, with no warranty. Nothing here is advice — legal, financial, or otherwise. Read it, enjoy it, and use your own judgment.
      </p>
      <p>
        Links to the merch shop at <a href="https://shop.remylobster.com">shop.remylobster.com</a> go to a store run on Fourthwall. Purchases and use of that shop are governed by <a href="https://fourthwall.com/legal/merchandise-terms-of-service" target="_blank" rel="noopener noreferrer">Fourthwall's Merchandise Terms of Service</a>, not by these terms.
      </p>
      <h2>Contact</h2>
      <p>
        Questions: <a href="https://x.com/thindery">@thindery</a> or <a href="https://x.com/RemyLobster">@RemyLobster</a> on X.
      </p>
    </div>
  </main>
  <Footer />
</Base>
